{
  "openapi": "3.0.0",
  "info": {
    "title": "ShopBite API",
    "description": "API for retrieving ShopBite configuration",
    "version": "1.0.0"
  },
  "paths": {
    "/shopbite/config": {
      "get": {
        "tags": ["ShopBite"],
        "summary": "Get ShopBite configuration",
        "description": "Retrieves ShopBite configuration including checkout status and delivery time",
        "operationId": "shopbite.config.get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Returns ShopBite Information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShopBiteConfig"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid API key"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "StoreApiKey": []
          }
        ]
      }
    },
    "/shopbite/business-hour": {
      "get": {
        "tags": ["ShopBite"],
        "summary": "Get business hours",
        "description": "Retrieves business hours for the current sales channel",
        "operationId": "shopbite.business-hour.get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Returns business hours",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessHourStruct"
                }
              }
            }
          }
        },
        "security": [
          {
            "StoreApiKey": []
          }
        ]
      }
    },
    "/shopbite/holiday": {
      "get": {
        "tags": ["ShopBite"],
        "summary": "Get holidays",
        "description": "Retrieves holidays for the current sales channel",
        "operationId": "shopbite.holiday.get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Returns holidays",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HolidayStruct"
                }
              }
            }
          }
        },
        "security": [
          {
            "StoreApiKey": []
          }
        ]
      }
    },
    "/shopbite/multi-channel-group": {
      "get": {
        "tags": ["ShopBite"],
        "summary": "Get MultiChannelGroup",
        "description": "Retrieves MultiChannelGroup information for the current sales channel",
        "operationId": "shopbite.multi-channel-group.get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Returns MultiChannelGroup information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MultiChannelGroupStruct"
                }
              }
            }
          }
        },
        "security": [
          {
            "StoreApiKey": []
          }
        ]
      }
    },
    "/shopbite/wishlist": {
      "post": {
        "tags": ["ShopBite"],
        "summary": "List wishlist items",
        "description": "Returns the configured dishes on the wishlist of the logged-in customer in the current sales channel, newest first. Requires a logged-in customer (sw-context-token header of a customer session); guests get 403 CHECKOUT__CUSTOMER_NOT_LOGGED_IN.",
        "operationId": "shopbite.wishlist.list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Wishlist items, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShopBiteWishlist"
                }
              }
            }
          },
          "403": {
            "description": "Customer is not logged in (CHECKOUT__CUSTOMER_NOT_LOGGED_IN)"
          }
        },
        "security": [
          {
            "StoreApiKey": []
          }
        ]
      }
    },
    "/shopbite/wishlist/add": {
      "post": {
        "tags": ["ShopBite"],
        "summary": "Add a configured dish to the wishlist",
        "description": "Adds a product (variant) with its configuration. without and extras are trimmed, deduplicated and sorted. If the same product with the same configuration is already on the wishlist, the existing entry is returned. Requires a logged-in customer (sw-context-token header of a customer session); guests get 403 CHECKOUT__CUSTOMER_NOT_LOGGED_IN.",
        "operationId": "shopbite.wishlist.add",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["productId"],
                "properties": {
                  "productId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{32}$"
                  },
                  "without": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Names of deselected main ingredients"
                  },
                  "extras": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Product numbers of selected extras"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The created or already existing wishlist item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShopBiteWishlistItem"
                }
              }
            }
          },
          "400": {
            "description": "Invalid productId (SHOPBITE__WISHLIST_INVALID_PRODUCT_ID), unknown product (SHOPBITE__WISHLIST_PRODUCT_NOT_FOUND) or without/extras not a list of strings (SHOPBITE__WISHLIST_INVALID_CONFIGURATION)"
          },
          "403": {
            "description": "Customer is not logged in (CHECKOUT__CUSTOMER_NOT_LOGGED_IN)"
          }
        },
        "security": [
          {
            "StoreApiKey": []
          }
        ]
      }
    },
    "/shopbite/wishlist/{id}": {
      "delete": {
        "tags": ["ShopBite"],
        "summary": "Remove a wishlist item",
        "description": "Removes one entry from the wishlist of the logged-in customer. Requires a logged-in customer (sw-context-token header of a customer session); guests get 403 CHECKOUT__CUSTOMER_NOT_LOGGED_IN.",
        "operationId": "shopbite.wishlist.delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Wishlist item id",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Item removed"
          },
          "403": {
            "description": "Customer is not logged in (CHECKOUT__CUSTOMER_NOT_LOGGED_IN)"
          },
          "404": {
            "description": "No such item for this customer and sales channel (SHOPBITE__WISHLIST_ITEM_NOT_FOUND)"
          }
        },
        "security": [
          {
            "StoreApiKey": []
          }
        ]
      }
    },
    "/shopbite/wishlist/merge": {
      "post": {
        "tags": ["ShopBite"],
        "summary": "Merge guest wishlist items",
        "description": "Merges wishlist entries saved locally by a guest into the wishlist of the customer who just logged in. Same normalisation and deduplication as add. Items with an invalid productId, an unknown product or a malformed configuration are skipped; only the first 100 items are processed. Returns the full wishlist. Requires a logged-in customer (sw-context-token header of a customer session); guests get 403 CHECKOUT__CUSTOMER_NOT_LOGGED_IN.",
        "operationId": "shopbite.wishlist.merge",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["items"],
                "properties": {
                  "items": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "required": ["productId"],
                      "properties": {
                        "productId": {
                          "type": "string"
                        },
                        "without": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "Names of deselected main ingredients"
                        },
                        "extras": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "Product numbers of selected extras"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The full wishlist after merging, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShopBiteWishlist"
                }
              }
            }
          },
          "400": {
            "description": "items is not a list (SHOPBITE__WISHLIST_INVALID_ITEMS)"
          },
          "403": {
            "description": "Customer is not logged in (CHECKOUT__CUSTOMER_NOT_LOGGED_IN)"
          }
        },
        "security": [
          {
            "StoreApiKey": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ShopBiteConfig": {
        "type": "object",
        "description": "ShopBite configuration data",
        "properties": {
          "isCheckoutEnabled": {
            "type": "boolean",
            "description": "Whether checkout is enabled for ShopBite"
          },
          "deliveryTime": {
            "type": "integer",
            "minimum": 1,
            "description": "Default delivery time in minutes"
          },
          "addressStreet": {
            "type": "string",
            "nullable": true,
            "description": "Street and number of the shop, null if not configured"
          },
          "addressPostalCode": {
            "type": "string",
            "nullable": true,
            "description": "Postal code of the shop, null if not configured"
          },
          "addressCity": {
            "type": "string",
            "nullable": true,
            "description": "City of the shop, null if not configured"
          },
          "telephone": {
            "type": "string",
            "nullable": true,
            "description": "Telephone number in display format (e.g. +49 6104 71427), null if not configured"
          },
          "googleBusinessProfileUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "description": "Link to the shop's Google Business Profile, null if not configured"
          }
        },
        "required": ["isCheckoutEnabled", "deliveryTime"]
      },
      "BusinessHour": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "dayOfWeek": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "openingTime": {
            "type": "string"
          },
          "closingTime": {
            "type": "string"
          },
          "salesChannelId": {
            "type": "string",
            "format": "uuid"
          },
          "translated": {
            "type": "array",
            "items": {}
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "apiAlias": {
            "type": "string"
          }
        }
      },
      "BusinessHourStruct": {
        "type": "object",
        "properties": {
          "businessHours": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BusinessHour"
            }
          }
        }
      },
      "Holiday": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "salesChannelId": {
            "type": "string",
            "format": "uuid"
          },
          "translated": {
            "type": "array",
            "items": {}
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "apiAlias": {
            "type": "string"
          }
        }
      },
      "HolidayStruct": {
        "type": "object",
        "properties": {
          "holidays": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Holiday"
            }
          }
        }
      },
      "MultiChannelGroup": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "salesChannels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SalesChannel"
            }
          },
          "translated": {
            "type": "array",
            "items": {}
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "apiAlias": {
            "type": "string"
          }
        }
      },
      "SalesChannel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "domains": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Domain"
            }
          },
          "translated": {
            "type": "array",
            "items": {}
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "apiAlias": {
            "type": "string"
          }
        }
      },
      "Domain": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string"
          },
          "languageId": {
            "type": "string",
            "format": "uuid"
          },
          "currencyId": {
            "type": "string",
            "format": "uuid"
          },
          "snippetSetId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "translated": {
            "type": "array",
            "items": {}
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "apiAlias": {
            "type": "string"
          }
        }
      },
      "MultiChannelGroupStruct": {
        "type": "object",
        "properties": {
          "multiChannelGroup": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MultiChannelGroup"
            }
          }
        }
      },
      "ShopBiteWishlistItem": {
        "type": "object",
        "description": "A configured dish on the customer's wishlist",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "productId": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "productNumber": {
            "type": "string"
          },
          "without": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Names of deselected main ingredients"
          },
          "extras": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Product numbers of selected extras"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "apiAlias": {
            "type": "string",
            "enum": ["shopbite_wishlist_item"]
          }
        },
        "required": ["id", "productId", "productNumber", "without", "extras", "createdAt"]
      },
      "ShopBiteWishlist": {
        "type": "object",
        "properties": {
          "elements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShopBiteWishlistItem"
            }
          },
          "apiAlias": {
            "type": "string",
            "enum": ["shopbite_wishlist"]
          }
        },
        "required": ["elements"]
      }
    },
    "securitySchemes": {
      "StoreApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "sw-access-key",
        "description": "Shopware Store API access key"
      }
    }
  }
}